{
  "name": "zalo-for-linux",
  "version": "1.0.0",
  "description": "Unofficial Zalo port for Linux with ZaDark integration",
  "workspaces": [
    "native/addons/v8-profiles"
  ],
  "main": "main.js",
  "scripts": {
    "test": "node --test 'tests/**/*.test.js'",
    "bench": "node benchmarks/bench-all.js",
    "profile": "node --prof benchmarks/bench-all.js",
    "bench:patches": "node benchmarks/bench-patches-real.js",
    "start": "electron .",
    "check-versions": "node scripts/check-versions.js",
    "download": "node scripts/download.js",
    "prepare-zadark": "node scripts/prepare-zadark.js",
    "extract": "node scripts/extract.js",
    "prepare-app": "node scripts/prepare-app.js",
    "apply-patches": "node scripts/apply-patches.js",
    "extract-screenshot-assets": "node scripts/extract-screenshot-assets.js",
    "clean-unused": "node scripts/clean-unused.js",
    "build": "node scripts/build.js",
    "build:native": "node scripts/build-native.js",
    "main": "SETUP=true BUILD=true node scripts/main.js",
    "main:setup": "SETUP=true node scripts/main.js",
    "main:build": "BUILD=true node scripts/main.js"
  },
  "keywords": [
    "zalo",
    "zadark",
    "chat",
    "messaging",
    "linux"
  ],
  "author": "Việt Nam Linux Family <developer@vietnamlinuxfamily.net>",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/VN-Linux-Family/zalo-for-linux",
  "repository": {
    "type": "git",
    "url": "https://github.com/VN-Linux-Family/zalo-for-linux.git"
  },
  "bugs": {
    "url": "https://github.com/VN-Linux-Family/zalo-for-linux/issues"
  },
  "devDependencies": {
    "@ast-grep/napi": "^0.51.1",
    "@electron/asar": "^4.0.1",
    "electron": "^22.3.27",
    "electron-builder": "^26.0.12",
    "nan": "^2.18.0",
    "node-addon-api": "^8.9.2",
    "node-html-parser": "^7.0.1",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.zalo.linux",
    "productName": "Zalo",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "package.json",
      "plugins/**/*",
      "assets/**/*"
    ],
    "extraFiles": [
      {
        "from": "app",
        "to": "app",
        "filter": [
          "**/*",
          "!node_modules",
          "!package-lock.json"
        ]
      },
      {
        "from": "native/engines/zcall",
        "to": "zcall-native",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "plugins/screenshot/portal.py"
    ],
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "linux": {
      "executableName": "zalo",
      "target": "AppImage",
      "category": "Network",
      "desktop": {
        "entry": {
          "StartupWMClass": "Zalo"
        }
      },
      "synopsis": "Zalo messaging app for Linux",
      "description": "Unofficial port of Zalo messaging application for Linux systems.",
      "icon": "app/pc-dist/favicon-512x512.png"
    }
  },
  "dependencies": {
    "fs-extra": "^11.4.0"
  },
  "allowScripts": {
    "electron@22.3.27": true,
    "electron-winstaller@5.4.0": true,
    "sqlite3@6.0.1": true
  }
}
